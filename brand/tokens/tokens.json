        "locus.dark": "rgba(232, 230, 223, 0.12)",
        "locus.css": "var(--term-edge)"
      }
    },
    "term-ink": {
      "$value": "#e8e6df",
      "$type": "color",
      "$description": "Text in a terminal.",
      "$extensions": {
        "locus.dark": "#e8e6df",
        "locus.css": "var(--term-ink)"
      }
    },
    "term-soft": {
      "$value": "rgba(232, 230, 223, 0.5)",
      "$type": "color",
      "$description": "A terminal’s prompt.",
      "$extensions": {
        "locus.dark": "rgba(232, 230, 223, 0.5)",
        "locus.css": "var(--term-soft)"
      }
    },
    "reader": {
      "$value": "#0f8a7e",
      "$type": "color",
      "$description": "A reader’s colour on the website’s graphics.",
      "$extensions": {
        "locus.dark": "#0f8a7e",
        "locus.css": "var(--reader)"
      }
    }
  },
  "font": {
    "sans": {
      "$value": [
        "Spline Sans Mono Variable",
        "ui-monospace",
        "SF Mono",
        "Menlo",
        "Consolas",
        "monospace"
      ],
      "$type": "fontFamily",
      "$description": "The one face, Spline Sans Mono, named once.",
      "$extensions": {
        "locus.dark": [
          "Spline Sans Mono Variable",
          "ui-monospace",
          "SF Mono",
          "Menlo",
          "Consolas",
          "monospace"
        ],
        "locus.css": "var(--sans)"
      }
    }
  },
  "radius": {
    "panel-radius": {
      "$value": "12px",
      "$type": "dimension",
      "$description": "Cards and sheets.",
      "$extensions": {
        "locus.dark": "12px",
        "locus.css": "var(--panel-radius)"
      }
    },
    "control-radius": {
      "$value": "8px",
      "$type": "dimension",
      "$description": "Buttons, fields, segmented controls.",
      "$extensions": {
        "locus.dark": "8px",
        "locus.css": "var(--control-radius)"
      }
    }
  },
  "shadow": {
    "shadow": {
      "$value": "0 1px 1px rgba(21, 25, 30, 0.04), 0 8px 24px -8px rgba(21, 25, 30, 0.12)",
      "$description": "A card over the map.",
      "$extensions": {
        "locus.dark": "0 1px 1px rgba(0, 0, 0, 0.3), 0 10px 28px -8px rgba(0, 0, 0, 0.5)",
        "locus.css": "var(--shadow)"
      }
    },
    "shadow-high": {
      "$value": "0 2px 4px rgba(21, 25, 30, 0.05), 0 24px 60px -16px rgba(21, 25, 30, 0.22)",
      "$description": "A sheet or menu over everything.",
      "$extensions": {
        "locus.dark": "0 2px 4px rgba(0, 0, 0, 0.35), 0 28px 70px -16px rgba(0, 0, 0, 0.7)",
        "locus.css": "var(--shadow-high)"
      }
    }
  },
  "easing": {
    "ease-out": {
      "$value": [
        null,
        0.23,
        1,
        0.32,
        1
      ],
      "$type": "cubicBezier",
      "$description": "Things arriving: presses, cards, the mark’s fade.",
      "$extensions": {
        "locus.dark": [
          null,
          0.23,
          1,
          0.32,
          1
        ],
        "locus.css": "var(--ease-out)"
      }
    },
    "ease-drawer": {
      "$value": [
        null,
        0.32,
        0.72,
        0,
        1
      ],
      "$type": "cubicBezier",
      "$description": "Sheets and drawers sliding in.",
      "$extensions": {
        "locus.dark": [
          null,
          0.32,
          0.72,
          0,
          1
        ],
        "locus.css": "var(--ease-drawer)"
      }
    }
  }
}
