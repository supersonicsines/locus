    "hair-strong": {
      "$value": "rgba(21, 25, 30, 0.28)",
      "$type": "color",
      "$description": "A hairline that is on: hover, pressed, chosen.",
      "$extensions": {
        "locus.dark": "rgba(232, 230, 223, 0.28)",
        "locus.css": "var(--hair-strong)"
      }
