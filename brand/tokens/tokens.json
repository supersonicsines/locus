    "page": {
      "$value": "#f3f5f6",
      "$type": "color",
      "$description": "The website’s page.",
      "$extensions": {
        "locus.dark": "#11171e",
        "locus.css": "var(--page)"
      }
    },
    "sea": {
      "$value": "#e2e6ea",
      "$type": "color",
      "$description": "The map’s sea.",
      "$extensions": {
        "locus.dark": "#0c1117",
        "locus.css": "var(--sea)"
      }
    },
    "land": {
      "$value": "#fcfdfd",
      "$type": "color",
      "$description": "The map’s land.",
      "$extensions": {
        "locus.dark": "#1a212a",
        "locus.css": "var(--land)"
      }
    },
    "sealed-land": {
      "$value": "#fcf1ee",
      "$type": "color",
      "$description": "Land in a sealed area.",
      "$extensions": {
        "locus.dark": "#2a1d1e",
        "locus.css": "var(--sealed-land)"
      }
    },
    "live-sea": {
      "$value": "#cbdfef",
