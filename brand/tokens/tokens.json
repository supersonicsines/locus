{
  "$description": "Locus design tokens, light values with the dark ones beside them. Written by brand/source/build.mjs from the app’s stylesheets; don’t edit.",
  "color": {
    "alert": {
      "$value": "#f5b400",
      "$type": "color",
      "$description": "Amber: urgent, it needs you now, and nothing else.",
      "$extensions": {
        "locus.dark": "#dea400",
        "locus.css": "var(--alert)"
      }
    },
    "on-alert": {
      "$value": "#15191e",
      "$type": "color",
      "$description": "Text on amber.",
      "$extensions": {
        "locus.dark": "#15191e",
        "locus.css": "var(--on-alert)"
      }
    },
    "live": {
      "$value": "#3b78b8",
      "$type": "color",
      "$description": "Blue: live, and nothing else. The live dot, and the sea when a copy is live.",
      "$extensions": {
        "locus.dark": "#7fb0e0",
        "locus.css": "var(--live)"
      }
    },
    "paper": {
      "$value": "#e2e6ea",
      "$type": "color",
      "$description": "The Studio’s ground: the sea round the map.",
      "$extensions": {
        "locus.dark": "#0e1319",
        "locus.css": "var(--paper)"
      }
    },
    "field": {
      "$value": "#eef1f3",
      "$type": "color",
      "$description": "A field or a key on a raised sheet.",
      "$extensions": {
        "locus.dark": "#0e1319",
        "locus.css": "var(--field)"
      }
    },
    "raised": {
      "$value": "#fcfdfd",
      "$type": "color",
      "$description": "Paper that floats over the map: cards, sheets, menus. The mark’s tile is this paper.",
      "$extensions": {
        "locus.dark": "#161c24",
        "locus.css": "var(--raised)"
      }
    },
    "ink": {
      "$value": "#15191e",
      "$type": "color",
      "$description": "Text, lines and the mark. Everything is ink or a share of it.",
      "$extensions": {
        "locus.dark": "#e8e6df",
        "locus.css": "var(--ink)"
      }
    },
    "ink-rgb": {
      "$value": "21, 25, 30",
      "$description": "Ink as r, g, b, for shares of it.",
      "$extensions": {
        "locus.dark": "232, 230, 223",
        "locus.css": "var(--ink-rgb)"
      }
    },
    "focus": {
      "$value": "rgba(21, 25, 30, 0.62)",
      "$type": "color",
      "$description": "The focus ring.",
      "$extensions": {
        "locus.dark": "rgba(232, 230, 223, 0.66)",
        "locus.css": "var(--focus)"
      }
    },
    "soft": {
      "$value": "rgba(21, 25, 30, 0.72)",
      "$type": "color",
      "$description": "Secondary text.",
      "$extensions": {
        "locus.dark": "rgba(232, 230, 223, 0.74)",
        "locus.css": "var(--soft)"
      }
    },
    "faint": {
      "$value": "rgba(21, 25, 30, 0.6)",
      "$type": "color",
      "$description": "Tertiary text: meta, numbers beside labels.",
      "$extensions": {
        "locus.dark": "rgba(232, 230, 223, 0.6)",
        "locus.css": "var(--faint)"
      }
    },
    "hair": {
      "$value": "rgba(21, 25, 30, 0.14)",
      "$type": "color",
      "$description": "Hairlines: borders, rules, dividers.",
      "$extensions": {
        "locus.dark": "rgba(232, 230, 223, 0.13)",
        "locus.css": "var(--hair)"
      }
