        "locus.dark": "#0c1c2c",
        "locus.css": "var(--live-sea)"
      }
    },
    "vermilion-ink": {
      "$value": "#c4351f",
      "$type": "color",
      "$description": "Vermilion as text: a sealed area’s words.",
