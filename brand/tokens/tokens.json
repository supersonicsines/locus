        "locus.css": "var(--wax-shadow)"
      }
    },
    "grid": {
      "$value": "rgba(21, 25, 30, 0.055)",
      "$type": "color",
      "$description": "The faint grid on a map plate.",
      "$extensions": {
        "locus.dark": "rgba(232, 230, 223, 0.045)",
        "locus.css": "var(--grid)"
      }
    },
    "dash": {
      "$value": "rgba(21, 25, 30, 0.36)",
