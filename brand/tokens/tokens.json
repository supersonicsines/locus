      "$extensions": {
        "locus.dark": "rgba(232, 230, 223, 0.05)",
        "locus.css": "var(--wash)"
      }
    },
    "wash-strong": {
      "$value": "rgba(21, 25, 30, 0.08)",
      "$type": "color",
      "$description": "A press’s tint, inline code.",
      "$extensions": {
        "locus.dark": "rgba(232, 230, 223, 0.09)",
        "locus.css": "var(--wash-strong)"
      }
    },
    "vermilion": {
      "$value": "#d63c27",
      "$type": "color",
