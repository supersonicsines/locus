# Copy to .env, then: docker compose --profile public up -d
# Your domain. The Studio is at https://<domain>, and every map at https://<name>.<domain>.
# Point both <domain> and *.<domain> at this server (A records, or a CNAME for the wildcard).
LOCUS_DOMAIN=example.com

# 1 for a host that's yours alone. For a public host, read docs/SECURITY.md first, then raise it.
LOCUS_MAX_ACCOUNTS=1

# Shown to anyone reporting a map. Required in practice for a public host.
LOCUS_ABUSE_CONTACT=

# Optional: sign in with Google. Both or neither. docs/SELF-HOSTING.md says how to get them.
LOCUS_GOOGLE_CLIENT_ID=
LOCUS_GOOGLE_CLIENT_SECRET=
