{
  "name": "locus-harness",
  "version": "0.1.0",
  "description": "A map of your company that any agent can read. Encrypted, gated, open source.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "locus": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "licenses",
    "docs/SECURITY.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "preview:google": "node --experimental-strip-types --no-warnings scripts/preview-google.mjs",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node dist/cli.mjs serve",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "workbench": "node scripts/workbench.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@fontsource-variable/spline-sans-mono": "^5.3.0",
    "@types/d3-contour": "^3.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "d3-contour": "^4.0.2",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
